# ============================================================
# Git 忽略规则
# 目标：只提交「源码 + 文档 + SQL 脚本」，不提交生成物和敏感信息
# ============================================================

# ---------- 依赖 / 构建产物（体积大，能重新生成）----------
node_modules/
dist/
dist-ssr/
build/
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 运行时产生的东西 ----------
# 文件上传目录（用户上传的附件，不入库）
WebFile/
# Vite 缓存
.vite/
# Vue 编译缓存
*.tsbuildinfo

# ---------- 开发工具 ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
*.swp
*.swo

# ---------- 本地敏感配置（真实密码别提交）----------
# 如果你要放一份「带真实密码」的配置在本地，命名成下面这些，就不会被提交
application-local.yaml
application-local.yml
application-local.properties
application-prod.yaml
application-prod.yml
.env
.env.local
.env.*.local

# ---------- 数据库临时脚本 ----------
# 下划线开头的是开发期一次性脚本（已并入 ai_collab_hub.sql），不提交
ai-collab-hub-server/sql/_*.sql

# ---------- 其他 ----------
*.bak
*.bak[0-9]
*.tmp
*.orig
*.rej
