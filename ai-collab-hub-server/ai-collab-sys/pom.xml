<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.qll</groupId>
        <artifactId>ai-collab-hub</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ai-collab-sys</artifactId>
    <name>ai-collab-sys</name>
    <description>系统模块：用户、角色、权限、企业信息、邮件配置、用户注册审核</description>

    <dependencies>
        <!-- 本项目通用模块（统一返回结果、异常、常量等） -->
        <dependency>
            <groupId>com.qll</groupId>
            <artifactId>ai-collab-common</artifactId>
        </dependency>

        <!-- 第三方集成模块（邮件、文件存储等） -->
        <dependency>
            <groupId>com.qll</groupId>
            <artifactId>ai-collab-integration</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Hutool 工具集 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- Spring Web（DTO 校验、参数绑定等基础能力） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Jakarta Validation：@NotBlank / @Email / @Pattern 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 只取 spring-security-crypto，用它的 PasswordEncoder + BCrypt，不引入整套安全过滤器链 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Knife4j / OpenAPI3 注解（@Schema） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
