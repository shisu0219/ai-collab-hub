<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.qll</groupId>
        <artifactId>ai-collab-hub</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ai-collab-blog</artifactId>
    <packaging>jar</packaging>
    <name>ai-collab-blog</name>
    <description>合作内容模块：文章发布、对接申请、内容审核、收藏、进度流转</description>

    <dependencies>
        <!-- 公共模块：统一返回、异常、常量等 -->
        <dependency>
            <groupId>com.qll</groupId>
            <artifactId>ai-collab-common</artifactId>
        </dependency>

        <!-- 第三方集成模块（文件存储、邮件等能力） -->
        <dependency>
            <groupId>com.qll</groupId>
            <artifactId>ai-collab-integration</artifactId>
        </dependency>

        <!-- 消息通知模块：只依赖其 INoticeService 接口发站内信 -->
        <dependency>
            <groupId>com.qll</groupId>
            <artifactId>ai-collab-notice</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Hutool 工具集 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- Web（分页、@Transactional 等基础能力） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 本模块是被依赖的业务模块，不需要打成可执行 jar -->
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
